# Copie para .env.local (que não vai para o Git) e ajuste.
# Endereço da API (o Worker da Cloudflare).
VITE_API_URL=http://localhost:8787
# Endereço público do site, usado nos links de convite (no app Android não dá para descobrir sozinho).
VITE_WEB_URL=http://localhost:5173/
# 1 = mostra o botão "Entrar sem Google (teste)". Só funciona se o servidor também tiver DEV_LOGIN=1.
VITE_DEV_LOGIN=1
